-        </button>
-        <div id="homeProfileActionsPanel" class="profile-actions-panel home-profile-panel">
-          <div class="home-profile-info">
-            <div id="homeProfileMenuName" style="font-weight:700;">سلام شهروند</div>
-            <div id="homeProfileMenuPhone" style="font-size:13px; color:var(--text-muted);">0912 345 6789</div>
-          </div>
-          <button class="profile-action-btn" onclick="showScreen('screen-profile'); toggleHomeProfileMenu();">
