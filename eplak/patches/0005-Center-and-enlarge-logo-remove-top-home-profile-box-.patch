From fd8c1dae28410f3ab03d7431181e9961e08823c5 Mon Sep 17 00:00:00 2001
From: Eplak Developer <dev@eplak.ir>
Date: Tue, 15 Sep 2026 23:20:22 +0000
Subject: [PATCH 5/5] Center and enlarge logo, remove top home profile box,
 make bottom nav bar compact, and enforce strict mobile responsive boundaries

---
 .../app/src/main/assets/assets/css/style.css  | 102 ++++++++++++++----
 .../app/src/main/assets/index.html            |  27 +----
 eplak-fixed/assets/css/style.css              | 101 +++++++++++++----
 eplak-fixed/index.html                        |  27 +----
 4 files changed, 175 insertions(+), 82 deletions(-)

diff --git a/eplak-fixed/android-app/app/src/main/assets/assets/css/style.css b/eplak-fixed/android-app/app/src/main/assets/assets/css/style.css
index 06eef4f..27b5c45 100644
--- a/eplak-fixed/android-app/app/src/main/assets/assets/css/style.css
+++ b/eplak-fixed/android-app/app/src/main/assets/assets/css/style.css
@@ -129,12 +129,14 @@
     body {
       position: fixed;
       inset: 0;
-      width: 100vw;
-      height: 100dvh;
+      width: 100% !important;
+      height: 100% !important;
+      height: 100dvh !important;
+      overflow: hidden;
     }
     .phone-frame {
-      width: 100vw !important;
-      max-width: 100vw !important;
+      width: 100% !important;
+      max-width: 100% !important;
       height: 100% !important;
       height: 100dvh !important;
       max-height: 100dvh !important;
@@ -359,12 +361,12 @@
   }
   .input-field::placeholder { color: var(--text-muted); }
 
-  /* ===== NAV BAR ===== */
+  /* ===== NAV BAR (نوار ناوبری پایین — فشرده، شکیل، باریک و بهینه برای هر گوشی) ===== */
   .nav-bar {
     display: flex;
     align-items: center;
     justify-content: space-around;
-    padding: 10px 10px max(14px, env(safe-area-inset-bottom, 14px));
+    padding: 3px 4px max(5px, env(safe-area-inset-bottom, 5px));
     background: var(--nav-bg);
     backdrop-filter: blur(20px);
     -webkit-backdrop-filter: blur(20px);
@@ -372,28 +374,43 @@
     position: relative;
     z-index: 25;
     flex-shrink: 0;
+    min-height: 48px;
+    max-height: 56px;
+    box-sizing: border-box;
+    width: 100%;
   }
 
   .nav-item {
     display: flex;
     flex-direction: column;
     align-items: center;
-    gap: 4px;
+    justify-content: center;
+    gap: 1px;
     cursor: pointer;
-    padding: 6px 16px;
-    border-radius: 12px;
-    transition: all 0.3s;
+    padding: 3px 6px;
+    border-radius: 10px;
+    transition: all 0.2s ease;
     color: var(--text-muted);
-    font-size: 11px;
+    font-size: 9.5px;
     font-weight: 500;
+    line-height: 1.15;
     background: none;
     border: none;
     font-family: 'Vazirmatn', sans-serif;
+    letter-spacing: -0.2px;
+    flex: 1;
+    max-width: 68px;
+    user-select: none;
+  }
+  .nav-item svg {
+    width: 18px;
+    height: 18px;
+    stroke-width: 2.1;
   }
-  .nav-item svg { width: 22px; height: 22px; }
   .nav-item.active {
     color: var(--teal);
     background: rgba(0,201,167,0.1);
+    font-weight: 700;
   }
   .nav-item.active svg { stroke: var(--teal); }
 
@@ -403,9 +420,62 @@
     display: flex;
     align-items: center;
     justify-content: space-between;
-    padding: max(14px, env(safe-area-inset-top, 14px)) 16px 8px;
+    padding: max(8px, env(safe-area-inset-top, 8px)) 14px 6px;
     position: relative;
     z-index: 20;
+    min-height: 48px;
+    box-sizing: border-box;
+    width: 100%;
+  }
+
+  /* هدرهای اصلی برنامه با لوگوی وسط‌چین و بزرگتر */
+  .main-top-header,
+  .home-top-header,
+  .top-header:has(.header-logo-img) {
+    display: grid !important;
+    grid-template-columns: 1fr auto 1fr !important;
+    align-items: center !important;
+    padding: max(8px, env(safe-area-inset-top, 8px)) 16px 6px !important;
+    min-height: 50px;
+    box-sizing: border-box;
+    width: 100%;
+  }
+  .main-top-header > :first-child,
+  .home-top-header > :first-child,
+  .top-header:has(.header-logo-img) > :first-child {
+    justify-self: start;
+  }
+  .main-top-header .header-logo-img,
+  .main-top-header .home-logo-wrap,
+  .home-top-header .header-logo-img,
+  .home-top-header .home-logo-wrap,
+  .top-header:has(.header-logo-img) .header-logo-img,
+  .top-header:has(.header-logo-img) .home-logo-wrap {
+    justify-self: center;
+    margin: 0 auto;
+  }
+  .main-top-header > :last-child,
+  .home-top-header > :last-child,
+  .top-header:has(.header-logo-img) > :last-child {
+    justify-self: end;
+  }
+  .home-top-header .home-header-logo {
+    height: 44px;
+    width: auto;
+    max-height: 46px;
+    object-fit: contain;
+    filter: drop-shadow(0 2px 8px rgba(0,201,167,0.22));
+    transition: transform 0.25s ease;
+  }
+  .home-top-header .home-header-logo:hover {
+    transform: scale(1.05);
+  }
+
+  .header-logo-img {
+    height: 38px;
+    width: auto;
+    object-fit: contain;
+  }
   }
 
   .header-spacer {
@@ -2036,7 +2106,7 @@
 
   /* ===== HEADER LOGO (in-app top bar) ===== */
   .header-logo-img {
-    height: 30px;
+    height: 38px;
     width: auto;
     display: block;
     object-fit: contain;
@@ -2635,10 +2705,6 @@
      ===== SECTION: SERVICES (خدمات) — premium cards =====
      ========================================================= */
 
-  /* نوار پایین حالا ۵ آیتم دارد — تنظیم فاصله‌ها برای ۵ مورد */
-  .nav-bar { padding: 10px 8px max(14px, env(safe-area-inset-bottom, 14px)); justify-content: space-around; flex-shrink: 0; }
-  .nav-item { padding: 6px 10px; font-size: 10.5px; letter-spacing: -0.2px; }
-
   /* ---------- Hero بالای صفحه خدمات ---------- */
   .svc-hero {
     position: relative;
